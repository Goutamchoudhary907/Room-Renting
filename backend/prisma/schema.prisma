generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String          @unique
  password        String?
  createdAt       DateTime        @default(now())
  reset           String?
  phoneNumber     String?
  googleId        String?         @unique
  Payment         Payment[]
  savedProperties SavedProperty[]
  bookings        Booking[]
  Properties      Property[]

  @@map("user")
}

model Property {
  id               Int               @id @default(autoincrement())
  title            String
  description      String
  bedrooms         Int
  bathrooms        Int
  rentalType       String
  pricePerNight    Int?
  pricePerMonth    Int?
  depositAmount    Int?
  address          String?
  latitude         Decimal?
  longitude        Decimal?
  amenities        String[]
  maxGuests        Int?
  hostId           Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  availability     Json?
  bookingStatus    BookingStatusEnum @default(AVAILABLE)
  propertyType     String            @default("apartment")
  city             String?
  country          String?
  postalCode       String?
  state            String?
  street           String?
  flatOrHouse      String?
  formattedAddress String?
  landmark         String?
  locality         String?
  Payment          Payment[]
  savedBy          SavedProperty[]
  bookings         Booking[]
  images           Image[]           @relation("PropertyImages")
  host             User              @relation(fields: [hostId], references: [id])

  @@map("properties")
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId], name: "unique_user_property")
  @@index([userId])
  @@index([propertyId])
}

model Image {
  id         Int      @id @default(autoincrement())
  url        String
  propertyId Int
  property   Property @relation("PropertyImages", fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Booking {
  id                Int           @id @default(autoincrement())
  bookingId         String        @unique
  userId            Int
  propertyId        Int
  rentalType        String
  checkinDate       DateTime?
  checkoutDate      DateTime?
  moveInDate        DateTime?
  leaseDuration     Int?
  paymentStatus     PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  totalAmount       Decimal?
  guestCount        Int?
  bookingDate       DateTime      @default(now())
  specialRequests   String?
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  release_after     DateTime?
  payment           Payment[]
  property          Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("bookings")
}

model Payment {
  id                Int           @id @default(autoincrement())
  razorpayOrderId   String        @unique
  razorpayPaymentId String        @unique
  razorpaySignature String
  amount            Decimal
  currency          String        @default("INR")
  status            PaymentStatus
  userId            Int
  propertyId        Int
  bookingId         Int?
  paymentMethod     String?
  refundAmount      Decimal?
  refundId          String?
  refundNotes       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  property          Property      @relation(fields: [propertyId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  Refund            Refund[]

  @@index([userId])
  @@index([propertyId])
  @@index([bookingId])
}

model Refund {
  id               Int      @id @default(autoincrement())
  razorpayRefundId String   @unique
  paymentId        Int
  amount           Decimal
  currency         String   @default("INR")
  reason           String?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payment          Payment  @relation(fields: [paymentId], references: [id])
}

enum BookingStatusEnum {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
